# =============================================================================
# AI KNOWLEDGE ASSISTANT — CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Stack: FastAPI · Streamlit · Supabase pgvector (768d) · LangChain · Google Gemini
# Copie este arquivo para `.env` em desenvolvimento local. NUNCA envie `.env` ao GitHub.
# =============================================================================

# Ambiente de Execução (development | production)
APP_ENV=development
ENABLE_SEED_DOCUMENTS=true
DEMO_AUTO_LOGIN=true

# Backend FastAPI & CORS
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000
# Em produção, restringe ao domínio oficial na Vercel e ambientes locais
CORS_ALLOWED_ORIGINS=https://ai-knowledge-assistant-ragg.vercel.app,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8501,http://127.0.0.1:8501

# Supabase PostgreSQL + pgvector (vector(768))
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (Exclusivo no Backend — NUNCA expor no Frontend)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048

# Parâmetros do Pipeline RAG, Abstinência e Controle de Custos
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
RAG_MIN_SIMILARITY_THRESHOLD=0.30
RAG_MAX_QUESTION_CHARS=2000
MAX_CHUNKS_PER_DOCUMENT=250
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Segurança, Autenticação JWT e Limite de Upload
# Nota: Na Vercel Serverless o limite físico do payload HTTP é ~4.5 MB (MAX_UPLOAD_SIZE_MB=4)
JWT_SECRET_KEY=replace-with-a-secure-256-bit-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_UPLOAD_SIZE_MB=25
